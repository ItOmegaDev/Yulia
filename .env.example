# .env.example - Copy this file to .env and fill in your actual values.
# NEVER commit .env or actual secret keys to GitHub repository!

# Admin Dashboard Access Password
VITE_ADMIN_PASSWORD=

# Gemini AI API Key (Server-side)
GEMINI_API_KEY=

# Application Hosted Base URL
APP_URL=

# Firebase Client Configuration (Optional - for persistent cloud storage & sync)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

